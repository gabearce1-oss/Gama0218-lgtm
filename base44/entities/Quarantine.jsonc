{
  "name": "Quarantine",
  "type": "object",
  "properties": {
    "source_file": {
      "type": "string"
    },
    "source_file_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "google_doc",
        "text_file",
        "docx",
        "manual"
      ]
    },
    "passage_text": {
      "type": "string"
    },
    "voice_dimension": {
      "type": "string",
      "enum": [
        "CLS",
        "BIS",
        "SII",
        "MRF",
        "Code-Switching",
        "Voice",
        "Sensory",
        "Emotional Resonance",
        "Dialogue"
      ]
    },
    "opportunity_type": {
      "type": "string",
      "enum": [
        "prose_quality",
        "voice_match",
        "code_switch",
        "sensory_detail",
        "emotional_depth",
        "dialogue_strength",
        "rhythm"
      ]
    },
    "reason": {
      "type": "string"
    },
    "suggested_application": {
      "type": "string"
    },
    "match_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "quarantined",
        "approved",
        "rejected",
        "merged"
      ],
      "default": "quarantined"
    },
    "chapter_suggestion": {
      "type": "number"
    },
    "scanned_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source_file",
    "passage_text"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}