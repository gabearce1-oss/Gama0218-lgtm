{
  "name": "Skill",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "calibration": {
      "type": "string"
    },
    "dependency": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body_markdown": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "compiled_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ],
      "default": "draft"
    },
    "review_owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}