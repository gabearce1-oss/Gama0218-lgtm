{
  "name": "Dropbox Blocker Sync",
  "description": "Polls Dropbox for new Section 9 blocker updates and syncs P0/P1 changes into the Blockers panel every 5 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-06-30T04:40:17.254000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dropbox_blocker_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dropboxSyncBlockers",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}