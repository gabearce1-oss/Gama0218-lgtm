{
  "name": "Pacing Review Alert",
  "description": "Alerts the pacing reviewer when a RestorationDraft is approved (published) for final review.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RestorationDraft",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"published\" and .trigger.old_data.status != \"published\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pacing_review_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_pacing_reviewer": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertPacingReviewer",
            "args": {
              "draft_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify pacing reviewer",
            "description": "Omega + blocker guardrails"
          }
        }
      }
    ]
  }
}