{
  "name": "Sync quarantine log on change",
  "description": "Pushes quarantine log records to the Google Sheets QUARANTINE_LOG tab whenever an entry changes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "QuarantineLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_quarantine_log_on_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncQuarantineLogToSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}