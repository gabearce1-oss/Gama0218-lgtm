{
  "name": "Workbook Ledger Export to Sheets",
  "description": "Daily push of Chapter entity data to the WORKBOOK_LEDGER Google Sheets tab, preserving a clean record of manual edits.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "workbook_ledger_export_to_sheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncWorkbookLedgerToSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}